{
  "name": "customer-servicing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/customer-servicing/src",
  "prefix": "bofa-demo",
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/customer-servicing",
        "index": "apps/customer-servicing/src/index.html",
        "main": "apps/customer-servicing/src/main.ts",
        "polyfills": "apps/customer-servicing/src/polyfills.ts",
        "tsConfig": "apps/customer-servicing/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/customer-servicing/src/favicon.ico",
          "apps/customer-servicing/src/assets"
        ],
        "styles": ["apps/customer-servicing/src/styles.scss"],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "650kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/customer-servicing/src/environments/environment.ts",
              "with": "apps/customer-servicing/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "customer-servicing:build:production"
        },
        "development": {
          "buildTarget": "customer-servicing:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "customer-servicing:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/customer-servicing/**/*.ts",
          "apps/customer-servicing/**/*.html"
        ],
        "maxWarnings": 0
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/customer-servicing/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": []
}
