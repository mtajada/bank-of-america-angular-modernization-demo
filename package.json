{
  "name": "bank-of-america-angular-modernization-demo",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "nx",
    "start": "nx serve retail-banking",
    "start:retail": "nx serve retail-banking --port=4200",
    "start:servicing": "nx serve customer-servicing --port=4300",
    "build": "nx run-many --target=build --projects=retail-banking,customer-servicing",
    "lint": "nx run-many --target=lint --all",
    "test": "nx run-many --target=test --all --runInBand",
    "test:shared": "nx run-many --target=test --projects=shared-integrations,shared-secure-transfer --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:video": "playwright test --project=bank-of-america-demo-video",
    "test:devin-api": "node --test scripts/kickoff-devin-api.test.mjs",
    "devin:dry-run": "node scripts/kickoff-devin-api.mjs",
    "devin:kickoff": "node scripts/kickoff-devin-api.mjs --submit",
    "graph": "nx graph"
  },
  "private": true,
  "engines": {
    "node": "20.19.x"
  },
  "dependencies": {
    "@angular/animations": "18.1.5",
    "@angular/cdk": "18.1.5",
    "@angular/common": "18.1.5",
    "@angular/compiler": "18.1.5",
    "@angular/core": "18.1.5",
    "@angular/forms": "18.1.5",
    "@angular/material": "18.1.5",
    "@angular/platform-browser": "18.1.5",
    "@angular/platform-browser-dynamic": "18.1.5",
    "@angular/router": "18.1.5",
    "@nx/angular": "19.5.3",
    "rxjs": "7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "0.14.8"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "18.1.4",
    "@angular-devkit/core": "18.1.4",
    "@angular-devkit/schematics": "18.1.4",
    "@angular-eslint/eslint-plugin": "18.4.3",
    "@angular-eslint/eslint-plugin-template": "18.4.3",
    "@angular-eslint/template-parser": "18.4.3",
    "@angular/cli": "18.1.4",
    "@angular/compiler-cli": "18.1.5",
    "@angular/language-service": "18.1.5",
    "@schematics/angular": "18.1.4",
    "@nx/eslint": "19.5.3",
    "@nx/eslint-plugin": "19.5.3",
    "@nx/jest": "19.5.3",
    "@nx/workspace": "19.5.3",
    "@playwright/test": "1.62.1",
    "@types/jest": "29.5.12",
    "@types/node": "20.16.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-preset-angular": "14.6.2",
    "ng-packagr": "18.1.0",
    "nx": "19.5.3",
    "postcss": "^8.4.5",
    "postcss-import": "~14.1.0",
    "postcss-preset-env": "~7.5.0",
    "postcss-url": "~10.1.3",
    "prettier": "2.8.8",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.1",
    "typescript": "5.5.4"
  }
}
